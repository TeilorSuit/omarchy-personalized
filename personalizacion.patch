--- /dev/null
+++ b/launcher/app/src/main/java/com/omarchytv/home/TeilorPanelCoordinator.java
@@ -0,0 +1,45 @@
+package com.omarchytv.home;
+
+import android.app.Activity;
+import android.content.Context;
+import android.content.Intent;
+import android.view.View;
+import java.lang.ref.WeakReference;
+
+/** Own only one overlay and keep its motion small and inexpensive. */
+final class TeilorPanelCoordinator {
+    private static WeakReference<Activity> current = new WeakReference<>(null);
+    private static WeakReference<View> currentPanel = new WeakReference<>(null);
+    static void toggle(Context context, Class<? extends Activity> target) {
+        Activity active = current.get();
+        View panel = currentPanel.get();
+        if (active != null && panel != null && !active.isFinishing() && active.getClass() == target) {
+            close(active, panel);
+            return;
+        }
+        if (active != null && !active.isFinishing()) {
+            active.startActivity(new Intent(active, target));
+        } else {
+            context.startActivity(new Intent(context, target).addFlags(Intent.FLAG_ACTIVITY_NEW_TASK));
+        }
+    }
+    static void open(Activity activity, View panel) {
+        Activity previous = current.get();
+        current = new WeakReference<>(activity);
+        currentPanel = new WeakReference<>(panel);
+        if (previous != null && previous != activity && !previous.isFinishing()) previous.finish();
+        panel.setAlpha(0f);
+        panel.setTranslationX(12 * panel.getResources().getDisplayMetrics().density);
+        panel.animate().alpha(1f).translationX(0f).setDuration(150).start();
+        activity.overridePendingTransition(0, 0);
+    }
+    static void close(Activity activity, View panel) {
+        if (activity.isFinishing()) return;
+        panel.animate().cancel();
+        panel.animate().alpha(0f).translationX(10 * panel.getResources().getDisplayMetrics().density)
+                .setDuration(120).withEndAction(() -> { activity.finish(); activity.overridePendingTransition(0, 0); }).start();
+    }
+    static void destroyed(Activity activity) {
+        if (current.get() == activity) { current.clear(); currentPanel.clear(); }
+    }
+}
diff --git a/launcher/app/src/main/java/com/omarchytv/home/TeilorQuickPanel.java b/launcher/app/src/main/java/com/omarchytv/home/TeilorQuickPanel.java
