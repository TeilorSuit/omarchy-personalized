+/** Independent, translucent HDMI selector; Android's TV input player handles the actual picture. */
+public final class TeilorInputsPanel extends Activity {
+    private LinearLayout panel;
+    private int dp(float v) { return Math.round(v * getResources().getDisplayMetrics().density); }
+
+    @Override protected void onCreate(Bundle state) {
+        super.onCreate(state);
+        getWindow().setBackgroundDrawableResource(android.R.color.transparent);
+        getWindow().addFlags(WindowManager.LayoutParams.FLAG_FULLSCREEN);
+        FrameLayout root = new FrameLayout(this); root.setBackgroundColor(0x38000000);
+        root.setOnClickListener(v -> closePanel()); root.setFocusable(false);
+        panel = new LinearLayout(this); panel.setOrientation(LinearLayout.VERTICAL);
+        panel.setPadding(dp(20), dp(20), dp(20), dp(20)); panel.setOnClickListener(v -> { }); panel.setFocusable(false);
+        GradientDrawable bg = new GradientDrawable(GradientDrawable.Orientation.TL_BR,
+                new int[]{0xff17212d, 0xff2b4050, 0xff586b76}); bg.setCornerRadius(dp(20));
+        panel.setBackground(bg); panel.setElevation(dp(12));
+        FrameLayout.LayoutParams pos = new FrameLayout.LayoutParams(dp(270), -2, Gravity.END | Gravity.CENTER_VERTICAL);
+        pos.rightMargin = dp(20); root.addView(panel, pos);
+        TextView title = new TextView(this); title.setText("ENTRADAS"); title.setTextColor(Color.WHITE);
+        title.setTextSize(20); title.setTypeface(Typeface.MONOSPACE, Typeface.BOLD); panel.addView(title);
+        TextView sub = new TextView(this); sub.setText("Selecciona una fuente"); sub.setTextColor(0xffc1d1db);
+        sub.setTextSize(12); sub.setPadding(0, dp(3), 0, dp(12)); panel.addView(sub);
+        TvInputManager tv = (TvInputManager) getSystemService(TV_INPUT_SERVICE);
+        List<TvInputInfo> inputs = tv == null ? new ArrayList<>() : new ArrayList<>(tv.getTvInputList());
+        Collections.sort(inputs, (a,b) -> {
+            boolean ah = a.getType() == TvInputInfo.TYPE_HDMI, bh = b.getType() == TvInputInfo.TYPE_HDMI;
+            if (ah != bh) return ah ? -1 : 1;
+            return String.valueOf(a.loadLabel(this)).compareToIgnoreCase(String.valueOf(b.loadLabel(this)));
+        });
+        Button first = null;
+        for (TvInputInfo info : inputs) {
+            if (!info.isPassthroughInput()) continue;
+            CharSequence name = info.loadLabel(this);
+            String label = name == null ? "Entrada" : name.toString();
+            if (info.getType() == TvInputInfo.TYPE_HDMI && !label.toUpperCase(java.util.Locale.ROOT).contains("HDMI")) label = "HDMI " + label;
+            int stateCode = tv.getInputState(info.getId());
+            if (stateCode == TvInputManager.INPUT_STATE_CONNECTED) label += "  ·  Conectado";
+            final String id = info.getId(); Button row = TeilorQuickPanel.makeButton(this, label);
+            LinearLayout.LayoutParams rp = new LinearLayout.LayoutParams(-1, dp(48)); rp.topMargin = dp(6); panel.addView(row, rp);
+            if (first == null) first = row;
+            row.setOnClickListener(v -> openInput(id));
+        }
+        if (first == null) {
+            TextView empty = new TextView(this); empty.setText("No se detectaron entradas.");
+            empty.setTextColor(Color.WHITE); panel.addView(empty);
+        }
