+    }
+
+    @Override protected void onDestroy() { TeilorPanelCoordinator.destroyed(this); super.onDestroy(); }
+    @Override public void onBackPressed() { closePanel(); }
+    private void closePanel() { TeilorPanelCoordinator.close(this, panel); }
+
+    private void openInput(String id) {
+        try {
+            Intent open = new Intent(Intent.ACTION_VIEW).setDataAndType(
+                    TvContract.buildChannelUriForPassthroughInput(id), "vnd.android.cursor.item/channel")
+                    .setPackage("com.google.android.tv.inputplayer").addFlags(Intent.FLAG_ACTIVITY_NEW_TASK);
+            startActivity(open); finish();
+        } catch (RuntimeException ex) { Toast.makeText(this, "No se pudo abrir la entrada", Toast.LENGTH_SHORT).show(); }
+    }
+}
diff --git a/launcher/app/src/main/java/com/omarchytv/home/TeilorPanelCoordinator.java b/launcher/app/src/main/java/com/omarchytv/home/TeilorPanelCoordinator.java
