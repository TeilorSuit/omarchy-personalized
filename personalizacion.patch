+++ b/launcher/app/src/main/java/com/omarchytv/home/TeilorQuickPanel.java
@@ -0,0 +1,172 @@
+package com.omarchytv.home;
+
+import android.app.Activity;
+import android.content.Intent;
+import android.content.res.ColorStateList;
+import android.graphics.Canvas;
+import android.graphics.Color;
+import android.graphics.LinearGradient;
+import android.graphics.RadialGradient;
+import android.graphics.Paint;
+import android.graphics.PorterDuff;
+import android.graphics.PorterDuffXfermode;
+import android.graphics.Shader;
+import android.graphics.Typeface;
+import android.graphics.drawable.AnimatedImageDrawable;
+import android.graphics.drawable.Drawable;
+import android.graphics.drawable.GradientDrawable;
+import android.graphics.drawable.StateListDrawable;
+import android.os.Bundle;
+import android.provider.Settings;
+import android.view.Gravity;
+import android.view.WindowManager;
+import android.widget.Button;
+import android.widget.FrameLayout;
+import android.widget.ImageView;
+import android.widget.LinearLayout;
+import android.widget.TextClock;
+import android.widget.TextView;
+import android.widget.Toast;
+
+/** Hyundai's lightweight overlay, drawn over the currently visible app. */
+public final class TeilorQuickPanel extends Activity {
+    private android.graphics.drawable.Animatable erisAnimation;
+    private FrameLayout panel;
+    private int dp(float value) { return Math.round(value * getResources().getDisplayMetrics().density); }
+
+    @Override protected void onCreate(Bundle state) {
+        super.onCreate(state);
+        getWindow().setBackgroundDrawableResource(android.R.color.transparent);
+        getWindow().addFlags(WindowManager.LayoutParams.FLAG_FULLSCREEN);
+        FrameLayout root = new FrameLayout(this); root.setBackgroundColor(0x38000000);
+        root.setOnClickListener(v -> closePanel()); root.setFocusable(false);
+        panel = new FrameLayout(this);
+        GradientDrawable bg = new GradientDrawable(GradientDrawable.Orientation.TL_BR,
+                new int[]{0xff17212d, 0xff243646, 0xff899ba9, 0xfffaf8fa});
+        bg.setCornerRadius(dp(20)); panel.setBackground(bg); panel.setClipToOutline(true);
+        panel.setElevation(dp(12)); panel.setOnClickListener(v -> { }); panel.setFocusable(false);
+        FrameLayout.LayoutParams pp = new FrameLayout.LayoutParams(dp(350), dp(350), Gravity.END | Gravity.CENTER_VERTICAL);
+        pp.rightMargin = dp(20); root.addView(panel, pp);
+
+        android.view.View bloom = new android.view.View(this) {
+            private final Paint paint = new Paint(Paint.ANTI_ALIAS_FLAG);
+            @Override protected void onDraw(Canvas canvas) {
+                super.onDraw(canvas);
+                float w = getWidth(), h = getHeight();
+                paint.setShader(new RadialGradient(w * .91f, h * .91f, w * .76f,
+                        new int[]{0xfffaf8fa, 0xeefaf8fa, 0x00faf8fa},
+                        new float[]{0f, .42f, 1f}, Shader.TileMode.CLAMP));
+                canvas.drawRect(0, 0, w, h, paint); paint.setShader(null);
+            }
+        };
+        panel.addView(bloom, new FrameLayout.LayoutParams(-1, -1));
+        FadeImage art = new FadeImage(this);
+        FrameLayout.LayoutParams artPos = new FrameLayout.LayoutParams(dp(205), dp(205), Gravity.BOTTOM | Gravity.END);
+        panel.addView(art, artPos);
+        ImageView eris = new ImageView(this); eris.setScaleType(ImageView.ScaleType.CENTER_CROP);
+        art.addView(eris, new FrameLayout.LayoutParams(-1, -1));
+        try {
+            String asset = "eris-panel.gif";
+            try (java.io.InputStream probe = getAssets().open("eris-panel.webp")) { asset = "eris-panel.webp"; }
+            catch (java.io.IOException missing) { /* The optional high-quality WebP was not supplied. */ }
+            if (android.os.Build.VERSION.SDK_INT >= 28) {
+                Drawable image = android.graphics.ImageDecoder.decodeDrawable(
+                        android.graphics.ImageDecoder.createSource(getAssets(), asset),
+                        (decoder, info, source) -> {
+                            int w = info.getSize().getWidth(), h = info.getSize().getHeight();
+                            int limit = Math.max(dp(205), 430);
+                            int longest = Math.max(w, h);
+                            if (longest > limit) decoder.setTargetSize(
+                                    Math.max(1, Math.round(w * (float) limit / longest)),
+                                    Math.max(1, Math.round(h * (float) limit / longest)));
+                        });
+                image.setFilterBitmap(true); eris.setImageDrawable(image);
+                if (image instanceof AnimatedImageDrawable) {
+                    AnimatedImageDrawable anim = (AnimatedImageDrawable) image;
+                    anim.setRepeatCount(AnimatedImageDrawable.REPEAT_INFINITE); erisAnimation = anim;
+                }
+            } else {
+                try (java.io.InputStream in = getAssets().open(asset)) {
+                    eris.setImageBitmap(android.graphics.BitmapFactory.decodeStream(in));
+                }
+            }
+        } catch (java.io.IOException | RuntimeException ignored) { }
+
+        LinearLayout content = new LinearLayout(this); content.setOrientation(LinearLayout.VERTICAL);
+        FrameLayout.LayoutParams cp = new FrameLayout.LayoutParams(dp(165), -1, Gravity.START | Gravity.TOP);
+        cp.leftMargin = dp(20); cp.topMargin = dp(19); cp.bottomMargin = dp(12); panel.addView(content, cp);
+        TextClock clock = new TextClock(this); clock.setFormat12Hour("h:mm a"); clock.setFormat24Hour("HH:mm");
+        clock.setTextSize(30); clock.setTextColor(Color.WHITE); clock.setTypeface(Typeface.MONOSPACE, Typeface.BOLD);
+        content.addView(clock);
+        TextClock date = new TextClock(this); date.setFormat12Hour("EEE, d MMMM"); date.setFormat24Hour("EEE, d MMMM");
+        date.setTextSize(12); date.setTextColor(0xffe2d9df); date.setSingleLine(true); content.addView(date);
+        TextView title = new TextView(this); title.setText("AJUSTES RÁPIDOS"); title.setTextColor(0xffe6c6cc);
+        title.setTextSize(11); title.setPadding(0, dp(17), 0, dp(5)); content.addView(title);
+        add(content, "Imagen", new Intent("android.settings.DISPLAY_SETTINGS")
+                .setClassName("com.realtek.slices", "com.realtek.tv.settings.activity.PictureSetupActivity"));
+        add(content, "Sonido", new Intent("com.android.tv.action.VIEW_SOUND_SETTINGS")
+                .setClassName("com.realtek.slices", "com.realtek.tv.settings.activity.SoundSetupActivity"));
+        add(content, "Entradas", new Intent(this, TeilorInputsPanel.class));
+        add(content, "Más ajustes", new Intent(Settings.ACTION_SETTINGS));
+        setContentView(root); content.getChildAt(3).requestFocus(); TeilorPanelCoordinator.open(this, panel);
+    }
+
+    @Override protected void onResume() { super.onResume(); if (erisAnimation != null) erisAnimation.start(); }
+    @Override protected void onPause() { if (erisAnimation != null) erisAnimation.stop(); super.onPause(); }
+    @Override protected void onDestroy() { TeilorPanelCoordinator.destroyed(this); super.onDestroy(); }
+    @Override public void onBackPressed() { closePanel(); }
+    private void closePanel() { TeilorPanelCoordinator.close(this, panel); }
+
+    private void add(LinearLayout panel, String label, Intent intent) {
+        Button button = makeButton(this, label);
+        LinearLayout.LayoutParams p = new LinearLayout.LayoutParams(-1, dp(43)); p.topMargin = dp(5); panel.addView(button, p);
+        button.setOnClickListener(v -> {
+            try {
+                if (intent.getComponent() != null && TeilorInputsPanel.class.getName().equals(intent.getComponent().getClassName()))
+                    startActivity(intent);
+                else startActivity(intent.addFlags(Intent.FLAG_ACTIVITY_NEW_TASK));
+                finish();
+            }
+            catch (RuntimeException ex) { Toast.makeText(this, "No se pudo abrir " + label, Toast.LENGTH_SHORT).show(); }
+        });
+    }
+
+    static Button makeButton(Activity activity, String label) {
+        float density = activity.getResources().getDisplayMetrics().density;
+        Button button = new Button(activity); button.setText(label); button.setAllCaps(false); button.setTextSize(14);
+        button.setFocusableInTouchMode(true); button.setGravity(Gravity.CENTER_VERTICAL | Gravity.START);
+        button.setPadding(Math.round(14 * density), 0, Math.round(8 * density), 0);
+        GradientDrawable normal = new GradientDrawable(GradientDrawable.Orientation.LEFT_RIGHT,
+                new int[]{0xe52b2938, 0xd53e3444}); normal.setCornerRadius(12 * density);
+        GradientDrawable focused = new GradientDrawable(GradientDrawable.Orientation.LEFT_RIGHT,
+                new int[]{0xffffeeed, 0xffeacbcf}); focused.setCornerRadius(12 * density);
+        StateListDrawable states = new StateListDrawable(); states.addState(new int[]{android.R.attr.state_focused}, focused);
+        states.addState(new int[]{}, normal); button.setBackground(states);
+        button.setTextColor(new ColorStateList(new int[][]{new int[]{android.R.attr.state_focused}, new int[]{}},
+                new int[]{0xff38202b, Color.WHITE}));
+        return button;
+    }
+
+    /** Fades the white-edged original GIF into the panel at its upper and left edges. */
+    private final class FadeImage extends FrameLayout {
+        private final Paint mask = new Paint(Paint.ANTI_ALIAS_FLAG);
+        FadeImage(Activity context) { super(context); setWillNotDraw(false); }
+        @Override protected void dispatchDraw(Canvas canvas) {
+            int save = canvas.saveLayer(0, 0, getWidth(), getHeight(), null);
+            super.dispatchDraw(canvas);
+            mask.setXfermode(new PorterDuffXfermode(PorterDuff.Mode.DST_IN));
+            float w = getWidth(), h = getHeight();
+            mask.setShader(new RadialGradient(w * .76f, h * .78f, w * 1.02f,
+                    new int[]{0xffffffff, 0xffffffff, 0x00ffffff},
+                    new float[]{0f, .40f, 1f}, Shader.TileMode.CLAMP));
+            canvas.drawRect(0, 0, getWidth(), getHeight(), mask);
+            mask.setShader(new LinearGradient(0, 0, dp(85), 0,
+                    0x00ffffff, 0xffffffff, Shader.TileMode.CLAMP));
+            canvas.drawRect(0, 0, w, h, mask);
+            mask.setShader(new LinearGradient(0, 0, 0, dp(85),
+                    0x00ffffff, 0xffffffff, Shader.TileMode.CLAMP));
+            canvas.drawRect(0, 0, w, h, mask);
+            mask.setShader(null); mask.setXfermode(null); canvas.restoreToCount(save);
+        }
+    }
+}
